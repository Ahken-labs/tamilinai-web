# Copy to .env.local for local development. Production values live in Vercel → Environment Variables.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Analytics — leave empty locally so dev visits aren't tracked. Set in Vercel (Production) only.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
